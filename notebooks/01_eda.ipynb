# Insurance Risk Analytics - Exploratory Data Analysis
# Task 1: Understanding the data and identifying patterns

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import sys
sys.path.append('..')

from src.data_loader import load_insurance_data
from src.eda_utils import *

# Set style
plt.style.use('seaborn-v0_8-darkgrid')
sns.set_palette("husl")

# Load data
df = load_insurance_data()
print(f"Dataset shape: {df.shape}")
print(f"Columns: {df.columns.tolist()}")
df.head()

# ============================================
# 1. DATA SUMMARIZATION
# ============================================

# Numerical columns summary
numerical_cols = ['TotalPremium', 'TotalClaims', 'CalculatedPremiumPerTerm', 
                  'CustomValueEstimate', 'RegistrationYear', 'SumInsured', 
                  'LossRatio', 'Margin']

basic_stats(df, numerical_cols)

# Check data types
df.dtypes

# ============================================
# 2. DATA QUALITY ASSESSMENT
# ============================================

# Missing values check
missing_df = check_missing_values(df)
print("Missing values summary:")
print(missing_df)

# ============================================
# 3. UNIVARIATE ANALYSIS
# ============================================

# Distribution of key financial variables
fig, axes = plt.subplots(2, 2, figsize=(12, 10))

df['TotalPremium'].hist(ax=axes[0,0], bins=50, edgecolor='black')
axes[0,0].set_title('Distribution of Total Premium')

df['TotalClaims'].hist(ax=axes[0,1], bins=50, edgecolor='black')
axes[0,1].set_title('Distribution of Total Claims')

df['LossRatio'].hist(ax=axes[1,0], bins=50, edgecolor='black')
axes[1,0].set_title('Distribution of Loss Ratio')

df['Margin'].hist(ax=axes[1,1], bins=50, edgecolor='black')
axes[1,1].set_title('Distribution of Margin')

plt.tight_layout()
plt.savefig('../reports/univariate_analysis.png', dpi=150, bbox_inches='tight')
plt.show()

# Categorical variables
fig, axes = plt.subplots(1, 3, figsize=(15, 5))

df['Province'].value_counts().plot(kind='bar', ax=axes[0])
axes[0].set_title('Policies by Province')

df['Gender'].value_counts().plot(kind='bar', ax=axes[1])
axes[1].set_title('Policies by Gender')

df['VehicleType'].value_counts().plot(kind='bar', ax=axes[2])
axes[2].set_title('Policies by Vehicle Type')

plt.tight_layout()
plt.savefig('../reports/categorical_distribution.png', dpi=150, bbox_inches='tight')
plt.show()

# ============================================
# 4. BIVARIATE / MULTIVARIATE ANALYSIS
# ============================================

# Premium vs Claims scatter plot by Province
fig, ax = plt.subplots(figsize=(12, 8))

for province in df['Province'].unique():
    subset = df[df['Province'] == province]
    ax.scatter(subset['TotalPremium'], subset['TotalClaims'], 
               label=province, alpha=0.5)

ax.set_xlabel('Total Premium')
ax.set_ylabel('Total Claims')
ax.set_title('Premium vs Claims by Province')
ax.legend()
plt.savefig('../reports/premium_vs_claims_by_province.png', dpi=150, bbox_inches='tight')
plt.show()

# Correlation matrix
plot_correlation_matrix(df, numerical_cols, '../reports/correlation_matrix.png')

# ============================================
# 5. GEOGRAPHIC TRENDS
# ============================================

# Compare metrics across provinces
province_metrics = df.groupby('Province').agg({
    'TotalPremium': 'mean',
    'TotalClaims': 'mean',
    'LossRatio': 'mean',
    'Margin': 'mean'
}).round(2)

print("Province-wise metrics:")
print(province_metrics)

# Plot geographic trends
fig, axes = plt.subplots(2, 2, figsize=(14, 10))

province_metrics['TotalPremium'].plot(kind='bar', ax=axes[0,0], color='skyblue')
axes[0,0].set_title('Average Premium by Province')
axes[0,0].set_ylabel('Premium (R)')

province_metrics['TotalClaims'].plot(kind='bar', ax=axes[0,1], color='lightcoral')
axes[0,1].set_title('Average Claims by Province')
axes[0,1].set_ylabel('Claims (R)')

province_metrics['LossRatio'].plot(kind='bar', ax=axes[1,0], color='lightgreen')
axes[1,0].set_title('Loss Ratio by Province')
axes[1,0].set_ylabel('Loss Ratio')

province_metrics['Margin'].plot(kind='bar', ax=axes[1,1], color='gold')
axes[1,1].set_title('Margin by Province')
axes[1,1].set_ylabel('Margin (R)')

plt.tight_layout()
plt.savefig('../reports/geographic_trends.png', dpi=150, bbox_inches='tight')
plt.show()

# ============================================
# 6. OUTLIER DETECTION
# ============================================

# Boxplots for outlier detection
fig, axes = plt.subplots(1, 3, figsize=(15, 5))

df.boxplot(column='TotalPremium', ax=axes[0])
axes[0].set_title('Total Premium Outliers')

df.boxplot(column='TotalClaims', ax=axes[1])
axes[1].set_title('Total Claims Outliers')

df.boxplot(column='CustomValueEstimate', ax=axes[2])
axes[2].set_title('Vehicle Value Outliers')

plt.tight_layout()
plt.savefig('../reports/outlier_detection.png', dpi=150, bbox_inches='tight')
plt.show()

# ============================================
# 7. TEMPORAL TRENDS
# ============================================

# Convert TransactionMonth to datetime if needed
df['TransactionMonth'] = pd.to_datetime(df['TransactionMonth'])

# Monthly trends
monthly_metrics = df.set_index('TransactionMonth').resample('M').agg({
    'TotalPremium': 'sum',
    'TotalClaims': 'sum',
    'LossRatio': 'mean'
})

fig, axes = plt.subplots(3, 1, figsize=(12, 10))

monthly_metrics['TotalPremium'].plot(ax=axes[0], marker='o')
axes[0].set_title('Monthly Total Premium')
axes[0].set_ylabel('Premium (R)')

monthly_metrics['TotalClaims'].plot(ax=axes[1], marker='o', color='red')
axes[1].set_title('Monthly Total Claims')
axes[1].set_ylabel('Claims (R)')

monthly_metrics['LossRatio'].plot(ax=axes[2], marker='o', color='green')
axes[2].set_title('Monthly Loss Ratio')
axes[2].set_ylabel('Loss Ratio')

plt.tight_layout()
plt.savefig('../reports/temporal_trends.png', dpi=150, bbox_inches='tight')
plt.show()

# ============================================
# 8. VEHICLE MAKE ANALYSIS
# ============================================

# Claims by vehicle make
vehicle_claims = df.groupby('Make').agg({
    'TotalClaims': 'mean',
    'TotalPremium': 'mean',
    'LossRatio': 'mean'
}).sort_values('TotalClaims', ascending=False)

print("Vehicle Make Analysis:")
print(vehicle_claims.head(10))

# Plot top and bottom makes
fig, axes = plt.subplots(1, 2, figsize=(14, 6))

vehicle_claims.head(10)['TotalClaims'].plot(kind='barh', ax=axes[0], color='red')
axes[0].set_title('Top 10 Makes by Average Claims')
axes[0].set_xlabel('Average Claims (R)')

vehicle_claims.tail(10)['TotalClaims'].plot(kind='barh', ax=axes[1], color='green')
axes[1].set_title('Bottom 10 Makes by Average Claims')
axes[1].set_xlabel('Average Claims (R)')

plt.tight_layout()
plt.savefig('../reports/vehicle_claims_analysis.png', dpi=150, bbox_inches='tight')
plt.show()

# ============================================
# 9. KEY QUESTIONS ANSWERED
# ============================================

# Q1: Overall Loss Ratio
overall_loss_ratio = calculate_loss_ratio(df)
print(f"\nOverall Portfolio Loss Ratio: {overall_loss_ratio:.2%}")

# Loss ratio by Province, VehicleType, Gender
loss_by_group = {
    'Province': df.groupby('Province')['LossRatio'].mean(),
    'VehicleType': df.groupby('VehicleType')['LossRatio'].mean(),
    'Gender': df.groupby('Gender')['LossRatio'].mean()
}

for group, values in loss_by_group.items():
    print(f"\nLoss Ratio by {group}:")
    print(values.sort_values(ascending=False))

# Q2: Outliers in TotalClaims
claims_95th = df['TotalClaims'].quantile(0.95)
claims_99th = df['TotalClaims'].quantile(0.99)
print(f"\nTotalClaims - 95th percentile: {claims_95th:.2f}")
print(f"TotalClaims - 99th percentile: {claims_99th:.2f}")

# Q3: Temporal trends
print("\nTemporal Trends:")
print(f"Claim frequency changed from {monthly_metrics['LossRatio'].iloc[0]:.2%} "
      f"to {monthly_metrics['LossRatio'].iloc[-1]:.2%}")

# Q4: Vehicle makes
highest_claims = vehicle_claims['TotalClaims'].idxmax()
lowest_claims = vehicle_claims['TotalClaims'].idxmin()
print(f"\nHighest claim amount make: {highest_claims}")
print(f"Lowest claim amount make: {lowest_claims}")

# ============================================
# 10. INSIGHT-DRIVEN VISUALIZATIONS (3 creative plots)
# ============================================

# Insight 1: Premium Efficiency Score by Province
fig, ax = plt.subplots(figsize=(10, 6))

df['PremiumEfficiency'] = df['TotalClaims'] / df['TotalPremium']
efficiency_by_province = df.groupby('Province')['PremiumEfficiency'].mean().sort_values()

colors = ['red' if x > 0.5 else 'green' for x in efficiency_by_province.values]
efficiency_by_province.plot(kind='barh', ax=ax, color=colors)
ax.axvline(x=0.5, color='black', linestyle='--', label='Industry Benchmark (50%)')
ax.set_title('Premium Efficiency by Province\n(Lower is Better - Less Claims per Premium)')
ax.set_xlabel('Claim/Premium Ratio')
ax.legend()
plt.tight_layout()
plt.savefig('../reports/insight_premium_efficiency.png', dpi=150, bbox_inches='tight')
plt.show()

# Insight 2: Risk Heatmap by Vehicle Type and Gender
fig, ax = plt.subplots(figsize=(10, 8))

risk_pivot = df.pivot_table(
    values='LossRatio', 
    index='VehicleType', 
    columns='Gender', 
    aggfunc='mean'
)

sns.heatmap(risk_pivot, annot=True, fmt='.2%', cmap='RdYlGn_r', 
            center=0.3, ax=ax, cbar_kws={'label': 'Loss Ratio'})
ax.set_title('Risk Heatmap: Loss Ratio by Vehicle Type and Gender\n(Red = Higher Risk)')
plt.tight_layout()
plt.savefig('../reports/insight_risk_heatmap.png', dpi=150, bbox_inches='tight')
plt.show()

# Insight 3: Profitability Matrix (Margin vs Claims)
fig, ax = plt.subplots(figsize=(10, 8))

# Create segments based on margin and claims
df['Segment'] = pd.cut(df['Margin'], 
                        bins=[-float('inf'), 0, df['Margin'].quantile(0.5), float('inf')],
                        labels=['Loss', 'Low Profit', 'High Profit'])

scatter = ax.scatter(df['TotalPremium'], df['TotalClaims'], 
                     c=df['Margin'], cmap='RdYlGn', alpha=0.5, s=30)
ax.set_xlabel('Total Premium')
ax.set_ylabel('Total Claims')
ax.set_title('Profitability Matrix: Premium vs Claims\n(Color indicates Margin - Green = Profitable)')

plt.colorbar(scatter, ax=ax, label='Margin')
plt.tight_layout()
plt.savefig('../reports/insight_profitability_matrix.png', dpi=150, bbox_inches='tight')
plt.show()

# ============================================
# SUMMARY REPORT
# ============================================

print("\n" + "="*60)
print("EDA SUMMARY REPORT")
print("="*60)

print(f"\nData Overview:")
print(f"  Total Policies: {len(df):,}")
