print(f"  Unique Provinces: {df['Province'].nunique()}")
print(f"  Unique Postal Codes: {df['PostalCode'].nunique()}")

print(f"\nFinancial Metrics:")
print(f"  Total Premium Collected: R {df['TotalPremium'].sum():,.2f}")
print(f"  Total Claims Paid: R {df['TotalClaims'].sum():,.2f}")
print(f"  Overall Loss Ratio: {overall_loss_ratio:.2%}")
print(f"  Overall Margin: R {df['Margin'].sum():,.2f}")

print(f"\nRisk Metrics:")
print(f"  Claim Frequency: {calculate_claim_frequency(df):.2%}")
print(f"  Average Severity: R {calculate_average_severity(df):,.2f}")

print(f"\nHighest Risk Province: {loss_by_group['Province'].idxmax()}")
print(f"  Loss Ratio: {loss_by_group['Province'].max():.2%}")

print(f"\nLowest Risk Province: {loss_by_group['Province'].idxmin()}")
print(f"  Loss Ratio: {loss_by_group['Province'].min():.2%}")

print("\n" + "="*60)
print("EDA Complete! Check reports/ folder for visualizations.")
print("="*60)